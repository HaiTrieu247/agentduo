{
  "title": "Planner result: questions for the user, or the plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "questions"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "needs_clarification"
              ]
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "header",
                  "question",
                  "multi_select",
                  "options"
                ],
                "properties": {
                  "header": {
                    "type": "string"
                  },
                  "question": {
                    "type": "string"
                  },
                  "multi_select": {
                    "type": "boolean"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "description"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "plan"
              ]
            },
            "plan": {
              "title": "Codex planner output",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "summary",
                "goals",
                "scope_in",
                "scope_out",
                "architecture",
                "steps",
                "acceptance_criteria",
                "risks",
                "test_strategy",
                "open_questions",
                "feedback_resolution",
                "repo_notes",
                "baseline_failures"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "goals": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope_in": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope_out": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "architecture": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "description",
                      "files"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "files": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "criterion"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "criterion": {
                        "type": "string"
                      }
                    }
                  }
                },
                "risks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "risk",
                      "mitigation"
                    ],
                    "properties": {
                      "risk": {
                        "type": "string"
                      },
                      "mitigation": {
                        "type": "string"
                      }
                    }
                  }
                },
                "test_strategy": {
                  "type": "string"
                },
                "open_questions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "feedback_resolution": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "issue_id",
                      "decision",
                      "rationale"
                    ],
                    "properties": {
                      "issue_id": {
                        "type": "string"
                      },
                      "decision": {
                        "type": "string",
                        "enum": [
                          "accepted",
                          "partially_accepted",
                          "disputed"
                        ]
                      },
                      "rationale": {
                        "type": "string"
                      }
                    }
                  }
                },
                "repo_notes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "note"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                },
                "baseline_failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "gate",
                      "in_scope",
                      "rationale"
                    ],
                    "properties": {
                      "gate": {
                        "type": "string"
                      },
                      "in_scope": {
                        "type": "boolean"
                      },
                      "rationale": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
