{
  "title": "A worker's result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "files_changed",
    "question",
    "notes"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "description": "What you did"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": [
        "string",
        "null"
      ],
      "description": "When blocked: one precise question for the techlead"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything the reviewer or the testers should know"
    }
  }
}
