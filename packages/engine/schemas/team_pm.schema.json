{
  "title": "The PM's turn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "action"
  ],
  "properties": {
    "message": {
      "type": [
        "string",
        "null"
      ],
      "description": "What you tell the user now, in their language; null: nothing"
    },
    "action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "questions"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "questions"
              ]
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "header",
                  "question",
                  "multi_select",
                  "options"
                ],
                "properties": {
                  "header": {
                    "type": "string"
                  },
                  "question": {
                    "type": "string"
                  },
                  "multi_select": {
                    "type": "boolean"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "description"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "brief"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "brief"
              ]
            },
            "brief": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "goal",
                "scope",
                "out_of_scope",
                "constraints",
                "criteria",
                "notes"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "A short name for the work"
                },
                "goal": {
                  "type": "string",
                  "description": "What the user wants and why, in a few sentences"
                },
                "scope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "What is in scope"
                },
                "out_of_scope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "What is explicitly not part of this work"
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Technical or product constraints the user stated"
                },
                "criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "criterion"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "AC1, AC2…"
                      },
                      "criterion": {
                        "type": "string",
                        "description": "An observable, testable acceptance criterion"
                      }
                    }
                  }
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Anything else the team must know, or null"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "approve",
            "issues",
            "summary"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "plan_review"
              ]
            },
            "approve": {
              "type": "boolean",
              "description": "true: show the plan to the user; false: send it back to the techlead"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "issue",
                  "group"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "issue": {
                    "type": "string"
                  },
                  "group": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The group whose plan it is about (a team with groups), or null"
                  }
                }
              },
              "description": "Why it goes back (empty when approved)"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ],
              "description": "The plan as the user reads it, when approved"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "note",
            "group"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "lead_note"
              ]
            },
            "note": {
              "type": "string",
              "description": "A clarification for the techlead"
            },
            "group": {
              "type": [
                "string",
                "null"
              ],
              "description": "The group whose techlead it is for; null: every techlead"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "question_id",
            "answer"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "team_answer"
              ]
            },
            "question_id": {
              "type": "string"
            },
            "answer": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "question_id",
            "question"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "escalate"
              ]
            },
            "question_id": {
              "type": "string"
            },
            "question": {
              "type": "string",
              "description": "What the head PM must answer (an area PM only)"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "areas"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "areas"
              ]
            },
            "areas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "group",
                  "area",
                  "criteria"
                ],
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "area": {
                    "type": "string",
                    "description": "What this group builds, in a few sentences"
                  },
                  "criteria": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The acceptance criteria it is responsible for"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "brief"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "change_request"
              ]
            },
            "brief": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "goal",
                "scope",
                "out_of_scope",
                "constraints",
                "criteria",
                "notes"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "A short name for the work"
                },
                "goal": {
                  "type": "string",
                  "description": "What the user wants and why, in a few sentences"
                },
                "scope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "What is in scope"
                },
                "out_of_scope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "What is explicitly not part of this work"
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Technical or product constraints the user stated"
                },
                "criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "criterion"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "AC1, AC2…"
                      },
                      "criterion": {
                        "type": "string",
                        "description": "An observable, testable acceptance criterion"
                      }
                    }
                  }
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Anything else the team must know, or null"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "criteria",
            "summary"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "acceptance"
              ]
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "status",
                  "evidence"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "met",
                      "partly",
                      "not_met"
                    ]
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              }
            },
            "summary": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lessons"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "rule_lesson"
              ]
            },
            "lessons": {
              "type": "array",
              "description": "One entry for every settled incident listed, in this one turn",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "incident_id",
                  "rule",
                  "rationale"
                ],
                "properties": {
                  "incident_id": {
                    "type": "string",
                    "description": "The resolved incident the lesson is from"
                  },
                  "rule": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The preventive rule to append to the team's RULES.md, or null when no new rule is needed (also when another entry's rule covers it). Never a rule that removes or replaces another"
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Why this rule prevents it happening again (or why none is needed, naming the rule that covers it)"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exception_id",
            "rule_ids",
            "reason",
            "alternative",
            "task_ids",
            "unit",
            "summary"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exception_proposal"
              ]
            },
            "exception_id": {
              "type": "string",
              "description": "The request you assessed"
            },
            "rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The rules it would depart from (some of the request's)"
            },
            "reason": {
              "type": "string"
            },
            "alternative": {
              "type": "string",
              "description": "What the team would do instead"
            },
            "task_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The tasks it would cover (some of the request's); empty when it is for a unit"
            },
            "unit": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "description": "Work outside a task: the one unit it is about (null when the exception is for tasks)",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "planning",
                    "integration",
                    "apply",
                    "acceptance"
                  ]
                },
                "id": {
                  "type": "string",
                  "description": "Its identity exactly as the prompt names it (copy it from the request)"
                }
              }
            },
            "summary": {
              "type": "string",
              "description": "The proposal as the user reads it: the rules, the reason, the alternative and what work it covers"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exception_id",
            "reason"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exception_decline"
              ]
            },
            "exception_id": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "description": "Why the rules stand, for the member who asked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "incident_id",
            "exception_id",
            "questions"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "rule_question"
              ]
            },
            "incident_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "The incident you cannot decide on, or null"
            },
            "exception_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "The exception request you cannot decide on, or null; its work waits for the answer"
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "header",
                  "question",
                  "multi_select",
                  "options"
                ],
                "properties": {
                  "header": {
                    "type": "string"
                  },
                  "question": {
                    "type": "string"
                  },
                  "multi_select": {
                    "type": "boolean"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "description"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
