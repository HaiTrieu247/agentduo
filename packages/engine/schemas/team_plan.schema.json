{
  "title": "The techlead's plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "tasks",
    "risks",
    "report",
    "governance"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "The approach, in a few sentences"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "assignee",
          "testers",
          "area",
          "depends_on",
          "criteria",
          "test_focus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "T1, T2…"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "What to do, precisely enough for the assignee to do it without asking"
          },
          "assignee": {
            "type": "string",
            "description": "The name of the worker member who does it"
          },
          "testers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The names of the checker members who test it (at least one)"
          },
          "area": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The files or folders it touches"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the tasks that must be merged first"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of the acceptance criteria it serves"
          },
          "test_focus": {
            "type": "string",
            "description": "What its testers must cover"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "type": "string",
      "description": "One line for the PM"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "exception"
      ],
      "description": "Problems you saw with the team's rules and, only when a rule really does not fit your work, a request for an exception. Never act on an exception before the user has agreed to it",
      "properties": {
        "issues": {
          "type": "array",
          "description": "A disagreement with a member, or a deviation from what the user asked, that you saw; empty: none",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "summary",
              "rule_ids"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "disagreement",
                  "deviation"
                ]
              },
              "summary": {
                "type": "string",
                "description": "What happened, in a few sentences"
              },
              "rule_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The ids of the rules involved (empty: none)"
              }
            }
          }
        },
        "exception": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "rule_ids",
            "reason",
            "alternative"
          ],
          "description": "Ask for an exception to the rules for the work of this call, or null. The PM decides what to show the user. Asking is not finishing: your result does not complete the work while you ask",
          "properties": {
            "rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The ids of the rules that do not fit this work"
            },
            "reason": {
              "type": "string",
              "description": "Why they do not fit"
            },
            "alternative": {
              "type": [
                "string",
                "null"
              ],
              "description": "What you would do instead, or null"
            }
          }
        }
      }
    }
  }
}
