{
  "title": "Codex planner output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "goals",
    "scope_in",
    "scope_out",
    "architecture",
    "steps",
    "acceptance_criteria",
    "risks",
    "test_strategy",
    "open_questions",
    "feedback_resolution"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "test_strategy": {
      "type": "string"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feedback_resolution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "decision",
          "rationale"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "partially_accepted",
              "disputed"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
