{
  "title": "Codex code review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "approved",
    "reviewed_commit",
    "summary",
    "findings",
    "resolved_findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "reviewed_commit": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "file",
          "line",
          "issue",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "issue": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "resolved_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
