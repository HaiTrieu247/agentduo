{
  "title": "Codex code review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "approved",
    "reviewed_commit",
    "summary",
    "findings",
    "resolved_findings",
    "repo_notes",
    "gate_failures"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "reviewed_commit": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "file",
          "line",
          "issue",
          "recommendation",
          "origin",
          "evidence",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "issue": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "regression",
              "in_scope",
              "pre_existing",
              "out_of_scope",
              "unclear"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "resolved_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "note"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "gate_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "origin",
          "evidence"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "regression",
              "in_scope",
              "pre_existing",
              "unclear"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
