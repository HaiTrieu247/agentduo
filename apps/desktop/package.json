{
  "name": "agentduo-desktop",
  "productName": "AgentDuo",
  "version": "0.8.1",
  "private": true,
  "description": "agentduo as a desktop app: Codex plans and reviews, Claude Code critiques and implements, in one window.",
  "license": "MIT",
  "author": "Thinh Hai Trieu",
  "homepage": "https://github.com/HaiTrieu247/agentduo",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/build.mjs && node scripts/dev.mjs --no-build",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.mts",
    "test:e2e": "node scripts/test-electron.mjs",
    "package": "node scripts/package.mjs",
    "package:mac": "node scripts/package.mjs --mac",
    "package:win": "node scripts/package.mjs --win",
    "package:linux": "node scripts/package.mjs --linux",
    "pack:dir": "node scripts/package.mjs --dir",
    "test:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "playwright": "1.64.1"
  }
}
