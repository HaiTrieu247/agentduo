{
  "name": "agentduo",
  "version": "0.13.0",
  "description": "Two-agent development loop: Codex plans and reviews, Claude Code critiques and implements, with a live terminal UI.",
  "license": "MIT",
  "author": "Thinh Hai Trieu",
  "homepage": "https://agentduo.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiTrieu247/agentduo.git"
  },
  "type": "module",
  "bin": {
    "agentduo": "dist/cli.js",
    "duo": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "docs/README.vi.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "codex",
    "claude",
    "claude-code",
    "ai-agents",
    "multi-agent",
    "code-review",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test:pack": "node scripts/pack-smoke.mjs",
    "smoke:real": "npm run build && node scripts/smoke-real.mjs",
    "demo:ui": "npm run build && node scripts/demo-ui.mjs",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "npm --prefix ../.. run typecheck && npm --prefix ../.. test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agentduo/engine": "*",
    "@agentduo/host": "*",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0"
  }
}
