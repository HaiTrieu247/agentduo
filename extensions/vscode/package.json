{
  "name": "agentduo-vscode",
  "displayName": "agentduo",
  "description": "Codex plans and reviews, Claude Code critiques and implements: the agentduo channel in a VS Code sidebar.",
  "version": "0.6.2",
  "publisher": "HaiTrieuThinh",
  "license": "MIT",
  "author": "Thinh Hai Trieu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiTrieu247/agentduo.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "codex",
    "claude",
    "claude-code",
    "agents",
    "code-review"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:agentduo.conversation"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "agentduo runs Codex, Claude Code and your quality gates in the workspace, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "agentduo needs the workspace on disk, in a git repository."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentduo",
          "title": "agentduo",
          "icon": "media/agentduo.svg"
        }
      ]
    },
    "views": {
      "agentduo": [
        {
          "id": "agentduo.conversations",
          "name": "Conversations",
          "icon": "media/agentduo.svg",
          "contextualTitle": "agentduo"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentduo.conversations",
        "contents": "No conversations in this workspace yet. Each conversation opens in a tab of its own, beside your editors.\n[New Conversation](command:agentduo.newTask)"
      }
    ],
    "commands": [
      { "command": "agentduo.openChat", "title": "Open Chat", "category": "agentduo", "icon": { "light": "media/agentduo-light.svg", "dark": "media/agentduo-dark.svg" } },
      { "command": "agentduo.newTask", "title": "New Conversation", "category": "agentduo", "icon": "$(add)" },
      { "command": "agentduo.openConversation", "title": "Open Conversation", "category": "agentduo" },
      { "command": "agentduo.stop", "title": "Stop the Current Step", "category": "agentduo", "enablement": "agentduo.running" },
      { "command": "agentduo.resume", "title": "Resume the Latest Run", "category": "agentduo", "icon": "$(debug-continue)" },
      { "command": "agentduo.openSettings", "title": "Settings: Models, Effort and Permissions", "category": "agentduo", "icon": "$(settings-gear)" },
      { "command": "agentduo.openPlan", "title": "Open Plan", "category": "agentduo" },
      { "command": "agentduo.openChanges", "title": "Open Changes", "category": "agentduo" },
      { "command": "agentduo.openReport", "title": "Open Report", "category": "agentduo" },
      { "command": "agentduo.usage", "title": "Usage: Claude Code and Codex Plan Limits", "category": "agentduo" },
      { "command": "agentduo.doctor", "title": "Doctor: Check CLIs, Config and Workspace", "category": "agentduo" },
      { "command": "agentduo.openConfiguration", "title": "Open Configuration", "category": "agentduo" },
      { "command": "agentduo.chooseWorkspace", "title": "Choose Workspace Folder", "category": "agentduo" }
    ],
    "menus": {
      "editor/title": [
        { "command": "agentduo.openChat", "when": "activeWebviewPanelId != 'agentduo.conversation'", "group": "navigation@90" },
        { "command": "agentduo.newTask", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "navigation@1" },
        { "command": "agentduo.resume", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "navigation@2" },
        { "command": "agentduo.openSettings", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "navigation@3" },
        { "command": "agentduo.openPlan", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "1_run@1" },
        { "command": "agentduo.openChanges", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "1_run@2" },
        { "command": "agentduo.openReport", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "1_run@3" },
        { "command": "agentduo.usage", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "2_tools@1" },
        { "command": "agentduo.doctor", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "2_tools@2" },
        { "command": "agentduo.openConfiguration", "when": "activeWebviewPanelId == 'agentduo.conversation'", "group": "2_tools@3" },
        { "command": "agentduo.chooseWorkspace", "when": "activeWebviewPanelId == 'agentduo.conversation' && workspaceFolderCount > 1", "group": "2_tools@4" }
      ],
      "view/title": [
        { "command": "agentduo.newTask", "when": "view == agentduo.conversations", "group": "navigation@1" },
        { "command": "agentduo.doctor", "when": "view == agentduo.conversations", "group": "2_tools@1" },
        { "command": "agentduo.openConfiguration", "when": "view == agentduo.conversations", "group": "2_tools@2" },
        { "command": "agentduo.chooseWorkspace", "when": "view == agentduo.conversations && workspaceFolderCount > 1", "group": "2_tools@3" }
      ],
      "commandPalette": [
        { "command": "agentduo.openConversation", "when": "false" }
      ]
    },
    "configuration": {
      "title": "agentduo",
      "properties": {
        "agentduo.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path of the Node (>= 22.12) that runs agentduo's engine. Empty: the first suitable `node` on the `PATH` VS Code sees. Agents, models and permissions are set in `.agentduo/config.yaml` and the chat's slash commands, as for the `duo` CLI."
        }
      }
    }
  }
}
