{
  "name": "agentduo-monorepo",
  "version": "0.12.1",
  "private": true,
  "description": "agentduo's repository: the CLI (apps/cli), the VS Code extension (apps/vscode), the desktop app (apps/desktop) and the packages they share (packages/*).",
  "license": "MIT",
  "author": "Thinh Hai Trieu",
  "homepage": "https://agentduo.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiTrieu247/agentduo.git"
  },
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/host",
    "packages/webview",
    "apps/cli",
    "apps/vscode"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w agentduo",
    "typecheck": "tsc -p . && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:pack": "npm run test:pack -w agentduo",
    "typecheck:vscode": "npm run typecheck -w agentduo-vscode",
    "build:vscode": "npm run build -w agentduo-vscode",
    "test:vscode": "npm run test:host -w agentduo-vscode",
    "package:vscode": "npm run package -w agentduo-vscode",
    "test:pack:vscode": "npm run test:pack -w agentduo-vscode",
    "smoke:real": "npm run smoke:real -w agentduo",
    "demo:ui": "npm run demo:ui -w agentduo",
    "version": "node scripts/sync-versions.mjs && git add package-lock.json apps/cli/package.json apps/vscode/package.json apps/desktop/package.json apps/desktop/package-lock.json packages/engine/package.json packages/host/package.json packages/webview/package.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
