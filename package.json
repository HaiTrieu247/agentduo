{
  "name": "agentduo",
  "version": "0.7.3",
  "description": "Two-agent development loop: Codex plans and reviews, Claude Code critiques and implements, with a live terminal UI.",
  "license": "MIT",
  "author": "Thinh Hai Trieu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiTrieu247/agentduo.git"
  },
  "type": "module",
  "bin": {
    "agentduo": "dist/cli.js",
    "duo": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "docs/README.vi.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "codex",
    "claude",
    "claude-code",
    "ai-agents",
    "multi-agent",
    "code-review",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "typecheck:vscode": "tsc -p extensions/vscode",
    "build:vscode": "node scripts/build-vscode.mjs",
    "test:vscode": "node scripts/test-vscode.mjs",
    "package:vscode": "node scripts/build-vscode.mjs --package",
    "test:pack:vscode": "node scripts/vscode-pack-smoke.mjs",
    "smoke:real": "npm run build && node scripts/smoke-real.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo:ui": "npm run build && node scripts/demo-ui.mjs",
    "version": "node scripts/sync-vscode-version.mjs && git add extensions/vscode/package.json apps/desktop/package.json apps/desktop/package-lock.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/vscode": "~1.95.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "ink-testing-library": "^4.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
